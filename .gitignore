# local kernel-harness binary (built by verify/, not tracked)
verify/sm70_verify
graft-research/

# the launcher's per-user form state (kept next to llama-server, or beside the
# launcher when the build dir is read-only): never part of the source tree
sm70gui-config.json
sm70gui-config.json.*
sm70gui-profiles/

# PyInstaller output for the launcher (build_exe.bat). The one-file exe IS
# shipped (tools/sm70gui/sm70gui.exe, so a clone works without a build step);
# the intermediate tree, the spec and the dist/ copy stay out.
tools/sm70gui/build/
tools/sm70gui/dist/
*.spec
!tools/sm70gui/sm70gui.exe
# the launcher's packaging script is source, despite *.bat
!tools/sm70gui/build_exe.bat
# generated by verify/ablate.py
verify/abl_*.cuh
